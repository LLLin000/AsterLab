    {
      "kind": "calculator",
      "schema": 1,
      "title": "通用计算器",
      "description": "能力级通用配方与算量模块：支持溶液稀释、分组配平母液、梯度稀释、逐样本配平与自定义算术公式；派生值只读，不写 Run 事实。",
      "sdk": "2.0.0",
      "category": "measurement",
      "capabilities": ["quantity", "deterministic-calculation", "derived-output"],
      "permissions": ["document.edit"],
      "renderers": {
        "design": "calculator.editor",
        "document": "calculator.viewer",
        "run": "calculator.run"
      },
      "lifecycle": {
        "states": ["draft", "validated", "frozen"],
        "freeze": "immutable-revision"
      },
      "provenance": {"origin": "planned", "record_boundary": "run"},
      "modes": ["design", "protocol", "run", "notebook", "review"],
      "inputs": [
        {"name": "kind", "type": "string", "required": true},
        {"name": "id", "type": "string", "required": true},
        {"name": "schema", "type": "int", "required": true},
        {"name": "title", "type": "string"},
        {
          "name": "mode",
          "type": "enum",
          "values": ["dilution", "group_mastermix", "serial_dilution", "sample_normalize", "formula"],
          "required": true
        },
        {"name": "stock", "type": "quantity", "description": "母液浓度或用量对象：{value: 数值, unit: UCUM单位}"},
        {"name": "target", "type": "quantity", "description": "目标浓度或用量对象：{value: 数值, unit: UCUM单位}（维度需与 stock 一致）"},
        {"name": "final_volume", "type": "quantity", "dimension": "volume", "description": "终体积对象：{value: 10, unit: \"mL\"}"},
        {"name": "sample_count", "type": "int", "description": "样本/孔数；若同时填写 plate_ref 则建议与孔板已分配孔数保持一致"},
        {"name": "volume_per_unit", "type": "quantity", "dimension": "volume", "description": "单份/单孔体积对象：{value: 100, unit: \"uL\"}"},
        {"name": "excess_ratio", "type": "decimal", "description": "余量比例（如 0.15 表示多配 15%）"},
        {"name": "plate_ref", "type": "reference", "target": "plate", "description": "关联孔板模块 ID，自动按组汇总孔数"},
        {"name": "container_ref", "type": "reference", "target": "plate", "description": "关联容器模块 ID（同 plate_ref）"},
        {"name": "components", "type": "object-list", "description": "配液组分对象数组：{name, volume_per_unit?, volume?, stock?, target?, unit?, role?, note?}"},
        {"name": "dilution_factor", "type": "decimal"},
        {"name": "steps_count", "type": "int"},
        {"name": "target_mass", "type": "quantity"},
        {"name": "samples", "type": "object-list", "description": "逐样本配平输入对象数组：{sample_id, stock_concentration?, target_concentration?, volume?}"},
        {"name": "stock_ref", "type": "string"},
        {"name": "formula", "type": "string"},
        {"name": "unit", "type": "string"},
        {"name": "result_unit", "type": "string", "description": "可选计算结果目标单位"},
        {"name": "upstream_endpoint", "type": "string", "description": "可选上游读数指标键（跨步计算器引用）"},
        {"name": "inputs", "type": "object"},
        {"name": "rows", "type": "object-list", "description": "通用参数公式表行数组：{key, label, kind(input|formula), value?, unit?, formula?}"}
      ],
      "outputs": [
        {"name": "derived_table", "type": "object", "origin": "derived", "calculator": "calculator.v2"}
      ],
      "actions": [],
      "rules": ["calculator-fields"]
    },
    {
      "kind": "timer",
