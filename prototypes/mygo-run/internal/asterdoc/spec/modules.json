{
  "schemaVersion": 1,
  "modules": [
    {
      "kind": "plate",
      "schema": 1,
      "title": "孔板",
      "description": "参数化孔板；format 选择孔板几何，groups 分配组别，samples 与 replicates 显式记录孔位身份。",
      "modes": [
        "design",
        "protocol",
        "run",
        "notebook",
        "review"
      ],
      "inputs": [
        {
          "name": "kind",
          "type": "string",
          "required": true,
          "description": "固定为 plate"
        },
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "文档内稳定 ID"
        },
        {
          "name": "schema",
          "type": "int",
          "required": true,
          "description": "模块版本，当前为 1"
        },
        {
          "name": "format",
          "type": "int",
          "required": true,
          "description": "孔数：6/12/24/48/96/384"
        },
        {
          "name": "assay",
          "type": "reference",
          "description": "关联检测 ID",
          "target": "assay"
        },
        {
          "name": "timepoint",
          "type": "timepoint",
          "description": "该布局所属时间点"
        },
        {
          "name": "groups",
          "type": "well-map",
          "required": true,
          "description": "组名到孔位列表"
        },
        {
          "name": "samples",
          "type": "object",
          "description": "孔位到显式 sample ID；不可根据组别或孔位顺序推断独立样本。"
        },
        {
          "name": "replicates",
          "type": "object",
          "description": "孔位到正整数技术重复编号；每个重复编号都必须关联显式 sample ID。"
        }
      ],
      "outputs": [
        {
          "name": "rows",
          "type": "int",
          "description": "由 format 决定的行数",
          "origin": "view"
        },
        {
          "name": "columns",
          "type": "int",
          "description": "由 format 决定的列数",
          "origin": "view"
        },
        {
          "name": "wells",
          "type": "well-map",
          "description": "孔位到组名",
          "origin": "view"
        },
        {
          "name": "samples",
          "type": "object",
          "description": "孔位到显式 sample ID",
          "origin": "view"
        },
        {
          "name": "replicates",
          "type": "object",
          "description": "孔位到技术重复编号",
          "origin": "view"
        }
      ],
      "actions": [
        {
          "id": "assign_wells",
          "title": "将选中孔位归入组别",
          "permission": "document.edit",
          "writes": [
            "groups"
          ]
        },
        {
          "id": "clear_wells",
          "title": "清除所选孔位",
          "permission": "document.edit",
          "writes": [
            "groups",
            "samples",
            "replicates"
          ]
        }
      ],
      "rules": [
        "plate-geometry-wells"
      ],
      "sdk": "1.0.0",
      "category": "labware",
      "capabilities": [
        "well-plate",
        "well-assignment",
        "plate-geometry"
      ],
      "permissions": [
        "document.edit"
      ],
      "renderers": {
        "design": "plate.editor",
        "document": "plate.viewer",
        "run": "plate.run"
      },
      "lifecycle": {
        "states": [
          "draft",
          "validated",
          "frozen"
        ],
        "freeze": "immutable-revision"
      },
      "provenance": {
        "origin": "planned",
        "record_boundary": "run"
      }
    },
