{
  "schemaVersion": 1,
  "foundationVersion": 1,
  "sdkVersion": "2.0.0",
  "modules": [
    {
      "kind": "plate",
      "schema": 1,
      "title": "标准容器 / 孔板",
      "description": "通用实验容器几何与组别/样本/孔位角色映射（6/12/24/48/96/384孔板、1D管架/泳道、培养皿、笼位）；不含任何实验专用配液公式。",
      "sdk": "2.0.0",
      "category": "labware",
      "capabilities": [
        "well-plate",
        "well-assignment",
        "plate-geometry"
      ],
      "permissions": [
        "document.edit"
      ],
      "renderers": {
        "design": "plate.editor",
        "document": "plate.viewer",
        "run": "plate.run"
      },
      "lifecycle": {
        "states": [
          "draft",
          "validated",
          "frozen"
        ],
        "freeze": "immutable-revision"
      },
      "provenance": {
        "origin": "planned",
        "record_boundary": "run"
      },
      "modes": [
        "design",
        "protocol",
        "run",
        "notebook",
        "review"
      ],
      "inputs": [
        {"name": "kind", "type": "string", "required": true, "description": "固定为 plate"},
        {"name": "id", "type": "string", "required": true, "description": "文档内稳定 ID"},
        {"name": "schema", "type": "int", "required": true, "description": "模块版本，当前为 1"},
        {"name": "title", "type": "string", "description": "容器标题"},
        {"name": "format", "type": "int", "required": true, "description": "标准孔板孔数 4/6/12/24/48/96/384，或自定义槽位数"},
        {
          "name": "topology",
          "type": "enum",
          "values": ["plate", "rack_1d", "dish", "cohort"],
          "description": "容器拓扑类型，默认 plate：plate/dish/cohort 使用行列坐标（如 dish format:4 为 A1..B2，cohort format:24 为 A1..D6）；rack_1d 默认 1 行使用 \"1\"..\"N\" 泳道/槽位号"
        },
        {"name": "rows", "type": "int", "description": "自定义行数"},
        {"name": "columns", "type": "int", "description": "自定义列数"},
        {"name": "assay", "type": "reference", "target": "assay", "description": "关联检测 ID"},
        {"name": "timepoint", "type": "timepoint", "description": "所属时间点"},
        {"name": "groups", "type": "well-map", "required": true, "description": "组别 ID 到孔位/槽位列表（rack_1d 的 Marker 等对照泳道若未归组则只放 roles 不放 samples）"},
        {"name": "samples", "type": "object", "description": "孔位到显式 sample ID（例如 {\"B2\": \"smp-ctrl-1\"}；建议与 replicates 成对填写以通过完整度检查）"},
        {"name": "replicates", "type": "object", "description": "孔位到正整数技术重复编号（1, 2, ...）；只要填写了 replicates，对应孔位必须在 samples 中声明 sample_id"},
        {"name": "roles", "type": "object", "description": "孔位到角色（sample/blank/vehicle/positive_control/negative_control/standard/ntc）"},
        {"name": "factors", "type": "object", "description": "正交实验因子标注映射（因子维度名 -> 孔位 -> 因子水平，如 靶点基因、加药浓度）"},
        {"name": "layers", "type": "object", "description": "统一多维属性图层映射（图层名 -> 孔位 -> 标注值），与 groups/factors 兼容共生"},
        {"name": "excluded_wells", "type": "string[]", "description": "可选异常或排空孔位坐标列表"}
      ],
      "outputs": [
        {"name": "rows", "type": "int", "origin": "view"},
        {"name": "columns", "type": "int", "origin": "view"},
        {"name": "wells", "type": "well-map", "origin": "view"},
        {"name": "samples", "type": "object", "origin": "view"},
        {"name": "replicates", "type": "object", "origin": "view"},
        {"name": "factors", "type": "object", "origin": "view"}
      ],
      "actions": [
        {"id": "assign_wells", "title": "将选中孔位归入组别", "permission": "document.edit", "writes": ["groups"]},
        {"id": "clear_wells", "title": "清除所选孔位", "permission": "document.edit", "writes": ["groups", "samples", "replicates", "roles", "factors"]}
      ],
      "rules": ["plate-geometry-wells"]
    },
    {
      "kind": "prose",
      "schema": 1,
      "title": "富文本 / 注意事项",
      "description": "通用说明段落、操作提示、安全或关键质控注意卡片。",
