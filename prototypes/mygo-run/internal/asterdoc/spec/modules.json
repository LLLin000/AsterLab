      "description": "以紧凑结构化表格集中定义实验分组、角色、处理条件、独立样本数与技术重复。",
      "sdk": "2.0.0",
      "category": "workflow",
      "capabilities": ["group-definition"],
      "permissions": ["document.edit"],
      "renderers": {
        "design": "group_table.editor",
        "document": "group_table.viewer",
        "run": "group_table.run"
      },
      "lifecycle": {
        "states": ["draft", "validated", "frozen"],
        "freeze": "immutable-revision"
      },
      "provenance": {"origin": "planned", "record_boundary": "run"},
      "modes": ["design", "protocol", "run", "notebook", "review"],
      "inputs": [
        {"name": "kind", "type": "string", "required": true},
        {"name": "id", "type": "string", "required": true},
        {"name": "schema", "type": "int", "required": true},
        {"name": "title", "type": "string"},
        {"name": "rows", "type": "object-list", "required": true, "description": "分组行对象数组：{id, name, role?(control|treatment|comparator|reference|blank|vehicle|positive_control|negative_control|standard|ntc|other), condition?, independent_n?(int), technical_repeats?(int)}"}
      ],
      "outputs": [
        {"name": "group_specs", "type": "object", "origin": "view"}
      ],
      "actions": [],
      "rules": ["group_table-fields"]
    },
    {
      "kind": "param_table",
      "schema": 1,
      "title": "参数表",
      "description": "通用步骤参数表：Design 记录计划值与单位，Run 可按需补记实测值与偏差。",
      "sdk": "2.0.0",
      "category": "measurement",
      "capabilities": ["parameter-table", "quantity"],
      "permissions": ["document.edit"],
      "renderers": {
        "design": "param_table.editor",
        "document": "param_table.viewer",
        "run": "param_table.run"
      },
      "lifecycle": {
        "states": ["draft", "validated", "frozen"],
        "freeze": "immutable-revision"
      },
      "provenance": {"origin": "planned", "record_boundary": "run"},
      "modes": ["design", "protocol", "run", "notebook", "review"],
      "inputs": [
        {"name": "kind", "type": "string", "required": true},
        {"name": "id", "type": "string", "required": true},
        {"name": "schema", "type": "int", "required": true},
        {"name": "title", "type": "string"},
        {"name": "rows", "type": "object-list", "required": true, "description": "参数行对象数组：{key, label, value, unit?(UCUM单位), actual?(实测偏离值), record_actual?(bool), note?}"}
      ],
      "outputs": [
        {"name": "parameters", "type": "object", "origin": "view"}
      ],
      "actions": [],
      "rules": ["param_table-fields"]
    },
    {
      "kind": "figure",
      "schema": 1,
      "title": "图片 / SVG 示意图",
      "description": "只承担视觉补充表达（手绘图、Agent 生成 SVG、本地图片引用），不承担结构化科学数据职责。",
      "sdk": "2.0.0",
