        "design": "generic.editor",
        "document": "dilution.viewer",
        "run": "generic.run"
      },
      "lifecycle": {
        "states": [
          "draft",
          "validated",
          "frozen"
        ],
        "freeze": "immutable-revision"
      },
      "provenance": {
        "origin": "planned",
        "record_boundary": "run"
      },
      "modes": [
        "design",
        "protocol",
        "run",
        "notebook",
        "review"
      ],
      "inputs": [
        {
          "name": "kind",
          "type": "string",
          "required": true
        },
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "schema",
          "type": "int",
          "required": true
        },
        {
          "name": "stock",
          "type": "quantity",
          "required": true,
          "dimension": "mass_concentration",
          "description": "母液浓度，例如 20 mg/mL"
        },
        {
          "name": "target",
          "type": "quantity",
          "required": true,
          "dimension": "mass_concentration",
          "description": "目标浓度，例如 2 mg/mL"
        },
        {
          "name": "final_volume",
          "type": "quantity",
          "required": true,
          "dimension": "volume",
          "description": "终体积，例如 5 mL"
        }
      ],
      "outputs": [
        {
          "name": "stock_volume",
          "type": "quantity",
          "dimension": "volume",
          "origin": "derived",
          "calculator": "dilution.v1",
          "description": "所需母液体积"
        },
        {
          "name": "diluent_volume",
          "type": "quantity",
          "dimension": "volume",
          "origin": "derived",
          "calculator": "dilution.v1",
