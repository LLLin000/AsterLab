        {"name": "layout", "type": "enum", "values": ["rows", "matrix"], "description": "表格呈现布局：按行列表 rows 或二维孔板矩阵 matrix"},
        {"name": "columns", "type": "object-list", "required": true, "description": "列定义对象数组：{key, label, value_kind(text|number|categorical|formula), unit?(UCUM单位), options?(categorical枚举选项数组), formula?(仅formula必填), min?(number), max?(number)}"},
        {"name": "rows", "type": "object-list", "description": "数据行对象数组（设计预填或运行实测直接原地写入）"}
      ],
      "outputs": [
        {"name": "table_view", "type": "object", "origin": "view"}
      ],
      "actions": [],
