{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterlab.local/schemas/asterml-foundation-v1.json",
  "title": "AsterML Foundation v1",
  "description": "Structural contract for AsterML module bodies and the shared module manifest. Scientific module fields remain declared by spec/modules.json; this schema freezes the common envelope and data types.",
  "$defs": {
    "moduleEnvelope": {
      "type": "object",
      "required": ["kind", "id", "schema"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "description": "Stable module kind; namespaces are dot-separated when needed."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Document-local stable identifier. Unique within one AsterML document."
        },
        "schema": {
          "type": "integer",
          "minimum": 1,
          "description": "Module structure version. A new version must not silently change old semantics."
        }
      }
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "UCUM code from the Foundation v1 unit registry subset."
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "description": "Typed in the module manifest with target; the target kind and document scope are validated by Core."
    },
    "artifact": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![Dd][Aa][Tt][Aa]:)",
          "description": "External artifact URI. Inline data URIs are not document data."
        },
        "media_type": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "label": {"type": "string"}
      },
      "additionalProperties": false
    },
    "duration": {
      "$ref": "#/$defs/quantity",
      "description": "A quantity whose registered unit dimension is time."
    },
    "timepoint": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["label"],
          "properties": {"label": {"type": "string", "minLength": 1}},
          "additionalProperties": true
        }
      ],
      "description": "A planned timepoint label. It is not an actual timestamp."
    },
    "relativeTime": {
      "type": "object",
      "required": ["anchor", "offset"],
      "properties": {
        "anchor": {"type": "string", "minLength": 1},
        "offset": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {
          "type": "string",
          "enum": ["blocking", "needs_confirmation", "advisory"]
        },
        "affects": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"}
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {
          "type": "string",
          "enum": [
            "string", "enum", "boolean", "integer", "decimal",
            "quantity", "reference", "list", "object", "table",
            "geometry", "artifact", "duration", "timepoint", "relative_time",
            "bool", "int", "number", "well-map", "string[]", "object-list"
          ]
        },
        "required": {"type": "boolean"},
        "description": {"type": "string"},
        "target": {"type": "string", "description": "Required for reference; names a module kind or module."},
        "item_type": {"type": "string"},
        "dimension": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}},
        "origin": {"type": "string", "enum": ["planned", "derived", "recorded", "view"]},
        "calculator": {"type": "string"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["id", "title", "permission", "writes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "permission": {"type": "string", "minLength": 1},
        "writes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "moduleManifest": {
      "type": "object",
      "required": ["kind", "schema", "title", "modes", "inputs", "outputs", "actions"],
      "properties": {
        "kind": {"$ref": "#/$defs/moduleEnvelope/properties/kind"},
        "schema": {"$ref": "#/$defs/moduleEnvelope/properties/schema"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "sdk": {"type": "string"},
        "category": {"type": "string", "enum": ["workflow", "resource", "labware", "measurement", "document", "device"]},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "renderers": {
          "type": "object",
          "properties": {
            "design": {"type": "string"},
            "document": {"type": "string"},
            "static": {"type": "string"}
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "states": {"type": "array", "items": {"type": "string"}},
            "freeze": {"type": "string"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "origin": {"type": "string", "enum": ["planned", "derived", "recorded"]},
            "record_boundary": {"type": "string"}
          },
          "additionalProperties": false
        },
        "modes": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "manifestFile": {
      "type": "object",
      "required": ["schemaVersion", "foundationVersion", "sdkVersion", "modules"],
      "properties": {
        "schemaVersion": {"type": "integer", "const": 1},
        "foundationVersion": {"type": "integer", "const": 1},
        "sdkVersion": {"type": "string", "minLength": 1},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/moduleManifest"}}
      },
      "additionalProperties": false
    },
    "moduleBody": {
      "allOf": [{"$ref": "#/$defs/moduleEnvelope"}],
      "type": "object",
      "additionalProperties": true,
      "description": "The three identity fields are frozen; scientific fields come from the matching module manifest."
    },
    "templateManifest": {
      "type": "object",
      "required": ["template_id", "version", "dependencies", "parameters", "requirements", "defaults", "instantiate", "provenance"],
      "properties": {
        "template_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "schema"],
            "properties": {
              "kind": {"type": "string"},
              "schema": {"type": "integer", "minimum": 1},
              "version_range": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "parameters": {"type": "array", "items": {"type": "object"}},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "defaults": {"type": "object"},
        "instantiate": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/manifestFile"},
    {"$ref": "#/$defs/moduleBody"},
    {"$ref": "#/$defs/templateManifest"}
  ]
}
