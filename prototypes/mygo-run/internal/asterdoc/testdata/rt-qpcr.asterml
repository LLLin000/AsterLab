```asterlab
kind: step
id: step-01-cdna-mix
schema: 1
execution: executable
title: 01 SYBR 反应体系配制与 cDNA 稀释
assay: assay-qpcr
timepoints: [40_cycles]
path: qpcr/01-mix
order: 1
blocks:
  - kind: param_table
    id: blk-qpcr-mix-params
    schema: 1
    title: 20 uL 单孔反应体系参数
    rows:
      - key: rxn_vol
        label: 单孔总体系
        value: 20
        unit: uL
        record_actual: true
      - key: primer_conc
        label: 上下游引物终浓度
        value: 0.4
        unit: uM
        record_actual: true
      - key: cdna_input
        label: 单孔 cDNA 上样量
        value: 2
        unit: uL
        record_actual: true
  - kind: calculator
    id: blk-qpcr-mastermix
    schema: 1
    title: SYBR qPCR MasterMix 按孔组批量配液（含 15% 余量）
    mode: group_mastermix
    plate_ref: plate-qpcr-96
    volume_per_unit:
      value: 20
      unit: uL
    excess_ratio: 0.15
    components:
      - name: SYBR Green Mix (2×)
        stock_percent: 100
        target_percent: 50
      - name: F/R 引物预混 (10 uM)
        stock_percent: 10
        target_percent: 0.4
```

```asterlab
kind: step
id: step-02-plate-setup
schema: 1
execution: executable
title: 02 96 孔多靶点加样与三复孔核查
assay: assay-qpcr
timepoints: [40_cycles]
path: qpcr/02-plate
order: 2
block_refs: [plate-qpcr-96]
blocks:
  - kind: checklist
    id: blk-qpcr-plate-checks
    schema: 1
    title: 加样与封膜质控确认
    items:
      - id: chk-ntc
        label: 确认 H4–H6 无模板阴参 NTC 无 cDNA 交叉污染
        required: true
      - id: chk-seal
        label: 光学封板膜封紧后 1500 rpm 离心 1 min 消除气泡
        required: true
```

```asterlab
kind: step
id: step-03-qpcr-run
schema: 1
execution: executable
title: 03 两步法扩增与 Ct 值记录
assay: assay-qpcr
timepoints: [40_cycles]
path: qpcr/03-readout
order: 3
blocks:
  - kind: timer
    id: blk-qpcr-run-timer
    schema: 1
    title: 上机扩增流程总耗时预估
    mode: countdown
    duration:
      value: 3900
      unit: s
  - kind: data_table
    id: dt-ct
    schema: 1
    title: Ct 扩增阈值记录表
    schema_id: qpcr_ct
    endpoint: Ct
    columns:
      - key: well
        label: 孔位
        value_kind: text
      - key: target
        label: 靶点基因
        value_kind: text
      - key: ct
        label: Ct 实测值
        value_kind: number
        unit: "1"
        min: 10
        max: 38
```

```asterlab
kind: workflow
id: wf-rtqpcr
schema: 1
steps: [step-01-cdna-mix, step-02-plate-setup, step-03-qpcr-run]
edges:
  - id: edge-qpcr-1
    from: step-01-cdna-mix
    to: step-02-plate-setup
  - id: edge-qpcr-2
    from: step-02-plate-setup
    to: step-03-qpcr-run
```
