{"ok":true,"result":{"design":true,"designId":"d5525203-56bb-4b52-82c4-0e05f0ed2ff8","issues":[],"order":["step-rna-extract","step-rna-qc","step-rt","step-qpcr"],"precedes":{"step-rna-extract":["step-rna-qc"],"step-rna-qc":["step-rt"],"step-rt":["step-qpcr"]},"revision":1,"roots":[{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","children":[{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/01-collect","identity":"definition","instruction":"转移细胞至 RNase-free 管；2,000 × g、5 min、4°C 离心；弃培养基，保留细胞沉淀。","kind":"step","path":"root/rna-extraction/01-collect","title":"01 收集细胞","total":1,"useId":"root/rna-extraction/01-collect"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/02-lyse","identity":"definition","instruction":"加入 Lysis Buffer（含 1% 2-巯基乙醇）；涡旋至沉淀完全分散；按说明书选择一种匀浆方式：Homogenizer 12,000 × g 2 min，或 18–21G 针头 5–10 次，或 rotor-stator 45 s 后 2,600 × g 5 min。","kind":"step","path":"root/rna-extraction/02-lyse","title":"02 裂解与匀浆","total":1,"useId":"root/rna-extraction/02-lyse"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/03-ethanol","identity":"definition","instruction":"加入等体积 70% 乙醇（1:1），涡旋混匀并分散可能出现的沉淀。","kind":"step","path":"root/rna-extraction/03-ethanol","title":"03 加乙醇","total":1,"useId":"root/rna-extraction/03-ethanol"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/04-bind","identity":"definition","instruction":"每次转移 ≤700 µL 至 Spin Cartridge（含 Collection Tube）；12,000 × g、15 s；弃流出液，保留吸附柱；重复至全部样品过柱。","kind":"step","path":"root/rna-extraction/04-bind","title":"04 上柱结合","total":1,"useId":"root/rna-extraction/04-bind"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/05-wash1","identity":"definition","instruction":"加 700 µL Wash Buffer I；12,000 × g、15 s；弃流出液和 Collection Tube；将吸附柱放入新的 Collection Tube。","kind":"step","path":"root/rna-extraction/05-wash1","title":"05 Wash I","total":1,"useId":"root/rna-extraction/05-wash1"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/06-wash2a","identity":"definition","instruction":"加 500 µL Wash Buffer II（含乙醇）；12,000 × g、15 s；弃流出液，吸附柱留在同一 Collection Tube。","kind":"step","path":"root/rna-extraction/06-wash2a","title":"06 Wash II 第一次","total":1,"useId":"root/rna-extraction/06-wash2a"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/07-wash2b","identity":"definition","instruction":"重复 Wash II：加 500 µL Wash Buffer II；12,000 × g、15 s；弃流出液。","kind":"step","path":"root/rna-extraction/07-wash2b","title":"07 Wash II 第二次","total":1,"useId":"root/rna-extraction/07-wash2b"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/08-dry","identity":"definition","instruction":"12,000 × g、1–2 min 干燥膜；弃 Collection Tube；将吸附柱放入 Recovery Tube。","kind":"step","path":"root/rna-extraction/08-dry","title":"08 干柱离心","total":1,"useId":"root/rna-extraction/08-dry"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/09-elute","identity":"definition","instruction":"加 30–100 µL RNase-free water 至膜中心；室温 1 min；≥12,000 × g、2 min；收集洗脱液。","kind":"step","path":"root/rna-extraction/09-elute","title":"09 RNA 洗脱","total":1,"useId":"root/rna-extraction/09-elute"},{"blockVersionId":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"root/rna-extraction/10-qc","identity":"definition","instruction":"记录 RNA 浓度与 A260/A280；按需冰上或 –80°C 保存。","kind":"step","path":"root/rna-extraction/10-qc","title":"10 RNA 质检与保存","total":1,"useId":"root/rna-extraction/10-qc"}],"composite":true,"definitionRef":"c23df8e1-3f2a-4449-8ac9-a4bb7256a113","id":"step-rna-extract","identity":"use","kind":"step","order":1,"path":"root/rna-extraction","title":"01 RNA 提取","total":10,"useId":"root/rna-extraction"},{"id":"step-rna-qc","identity":"use","kind":"step","order":2,"path":"root/rna-qc","title":"02 RNA 质控","total":1,"useId":"root/rna-qc"},{"id":"step-rt","identity":"use","kind":"step","order":3,"path":"root/reverse-transcription","title":"03 逆转录","total":1,"useId":"root/reverse-transcription"},{"id":"step-qpcr","identity":"use","kind":"step","order":4,"path":"root/qpcr","title":"04 qPCR 扩增及检测","total":1,"useId":"root/qpcr"}]},"tool":"workflow.inspect_tree"}
