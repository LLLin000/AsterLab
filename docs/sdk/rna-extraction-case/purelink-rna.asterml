```asterlab
kind: step
id: step-01
schema: 2
title: 01 收集细胞
assay: assay-rna
path: root/01-collect
order: 1
uses:
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
  - {ref: inst-centrifuge, role: instrument}
tasks:
  - {id: collect, title: "转移细胞至 RNase-free 管", kind: procedure}
  - {id: pellet, title: "2,000 x g 5 min 4 C，弃培养基", kind: procedure}
checks:
  - {checkId: c01-pellet, title: 保留细胞沉淀；弃培养基, blocking: true}
```

```asterlab
kind: step
id: step-02
schema: 2
title: 02 裂解与匀浆
assay: assay-rna
path: root/02-lyse
order: 2
uses:
  - {ref: mat-lysis, role: material}
  - {ref: inst-homogenizer, role: instrument}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: lyse, title: "加 Lysis Buffer + 1% 2-ME，涡旋", kind: procedure}
  - {id: homogenize, title: "选择一种匀浆方式", kind: procedure}
checks:
  - {checkId: c02-lysis, title: 细胞沉淀完全分散；匀浆方式已选定, blocking: true}
```

```asterlab
kind: step
id: step-03
schema: 2
title: 03 加乙醇
assay: assay-rna
path: root/03-ethanol
order: 3
uses:
  - {ref: mat-ethanol, role: material}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: ethanol, title: "加等体积 70% 乙醇", kind: procedure}
  - {id: mix, title: "涡旋混匀", kind: procedure}
checks:
  - {checkId: c03-ethanol, title: 70% 乙醇按 1:1 加入并混匀, blocking: true}
```

```asterlab
kind: step
id: step-04
schema: 2
title: 04 上柱结合
assay: assay-rna
path: root/04-bind
order: 4
uses:
  - {ref: cartridge-S01, role: other}
  - {ref: cartridge-S02, role: other}
  - {ref: cartridge-S03, role: other}
  - {ref: cartridge-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: load, title: "转移 <=700 µL 至 Spin Cartridge", kind: procedure}
  - {id: bind-spin, title: "12,000 x g 15 s，弃流出液，重复至全部过柱", kind: procedure}
checks:
  - {checkId: c04-bind, title: 弃流出液；保留吸附柱, blocking: true}
```

```asterlab
kind: step
id: step-05
schema: 2
title: 05 Wash I
assay: assay-rna
path: root/05-wash1
order: 5
uses:
  - {ref: mat-wash1, role: material}
  - {ref: cartridge-S01, role: other}
  - {ref: cartridge-S02, role: other}
  - {ref: cartridge-S03, role: other}
  - {ref: cartridge-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: wash1, title: "加 700 µL Wash Buffer I", kind: procedure}
  - {id: wash1-spin, title: "12,000 x g 15 s，弃流出液并换收集管", kind: procedure}
checks:
  - {checkId: c05-wash1, title: 弃流出液并更换 Collection Tube, blocking: true}
```

```asterlab
kind: step
id: step-06
schema: 2
title: 06 Wash II 第一次
assay: assay-rna
path: root/06-wash2a
order: 6
uses:
  - {ref: mat-wash2, role: material}
  - {ref: cartridge-S01, role: other}
  - {ref: cartridge-S02, role: other}
  - {ref: cartridge-S03, role: other}
  - {ref: cartridge-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: wash2a, title: "加 500 µL Wash Buffer II", kind: procedure}
  - {id: wash2a-spin, title: "12,000 x g 15 s，弃流出液", kind: procedure}
checks:
  - {checkId: c06-wash2a, title: 第一次 Wash II：弃流出液, blocking: true}
```

```asterlab
kind: step
id: step-07
schema: 2
title: 07 Wash II 第二次
assay: assay-rna
path: root/07-wash2b
order: 7
uses:
  - {ref: mat-wash2, role: material}
  - {ref: cartridge-S01, role: other}
  - {ref: cartridge-S02, role: other}
  - {ref: cartridge-S03, role: other}
  - {ref: cartridge-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: wash2b, title: "重复 500 µL Wash Buffer II", kind: procedure}
  - {id: wash2b-spin, title: "12,000 x g 15 s，弃流出液", kind: procedure}
checks:
  - {checkId: c07-wash2b, title: 第二次 Wash II：弃流出液, blocking: true}
```

```asterlab
kind: step
id: step-08
schema: 2
title: 08 干柱离心
assay: assay-rna
path: root/08-dry
order: 8
uses:
  - {ref: cartridge-S01, role: other}
  - {ref: cartridge-S02, role: other}
  - {ref: cartridge-S03, role: other}
  - {ref: cartridge-S04, role: other}
  - {ref: recovery-S01, role: other}
  - {ref: recovery-S02, role: other}
  - {ref: recovery-S03, role: other}
  - {ref: recovery-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: dry, title: "12,000 x g 1-2 min 干膜", kind: procedure}
  - {id: recovery, title: "弃 Collection Tube，换 Recovery Tube", kind: procedure}
checks:
  - {checkId: c08-dry, title: 膜已干燥；换 Recovery Tube, blocking: true}
```

```asterlab
kind: step
id: step-09
schema: 2
title: 09 RNA 洗脱
assay: assay-rna
path: root/09-elute
order: 9
uses:
  - {ref: mat-water, role: material}
  - {ref: recovery-S01, role: other}
  - {ref: recovery-S02, role: other}
  - {ref: recovery-S03, role: other}
  - {ref: recovery-S04, role: other}
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: water, title: "加 30-100 µL RNase-free water 至膜中心", kind: procedure}
  - {id: elute, title: "室温 1 min；>=12,000 x g 2 min", kind: procedure}
checks:
  - {checkId: c09-elute, title: 保留洗脱液（RNA 成品）, blocking: true}
```

```asterlab
kind: step
id: step-10
schema: 2
title: 10 RNA 质检与保存
assay: assay-rna
path: root/10-qc
order: 10
uses:
  - {ref: s-rna-01, role: sample}
  - {ref: s-rna-02, role: sample}
  - {ref: s-rna-03, role: sample}
  - {ref: s-rna-04, role: sample}
tasks:
  - {id: qc, title: "记录 RNA 浓度与 A260/A280", kind: measurement, readout: rna_qc}
  - {id: store, title: "记录保存位置", kind: procedure}
checks:
  - {checkId: c10-qc, title: RNA 浓度与 A260/A280 已记录, blocking: true}
```

