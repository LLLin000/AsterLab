// AsterLab 设计令牌：见 DESIGN.md。紫色只表示选择与主操作。
export global Theme {
    // 表面
    in property <color> bg: #f6f5f2;
    in property <color> sidebar: #efeee9;
    in property <color> surface: #ffffff;
    in property <color> surface-alt: #faf9f6;
    in property <color> hover: #f1efe9;
    in property <color> line: #e6e3dc;
    in property <color> line-strong: #d5d0c6;

    // 文字
    in property <color> ink: #1d1b18;
    in property <color> ink-2: #5c574f;
    in property <color> ink-3: #8f897f;

    // 选择与状态
    in property <color> accent: #5b45c9;
    in property <color> accent-hover: #4b37ae;
    in property <color> accent-soft: #eeeafc;
    in property <color> accent-tint: #faf9ff;
    in property <color> accent-line: #cec3f0;
    in property <color> neutral-soft: #f2f0ea;
    in property <color> warn-soft: #f6eedd;
    in property <color> warn-ink: #77602f;

    // 孔板：已映射是中性数据色，不是强调色
    in property <color> plate-body: #fbfaf7;
    in property <color> plate-line: #e3ded4;
    in property <color> well-empty: #f7f5f1;
    in property <color> well-empty-line: #ded9cf;
    in property <color> well-mapped: #cfc7b5;
    in property <color> well-mapped-line: #9b9280;

    // 间距（4px 网格）
    in property <length> space-1: 4px;
    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-5: 24px;
    in property <length> space-6: 32px;

    // 圆角
    in property <length> radius-sm: 6px;
    in property <length> radius-md: 10px;
    in property <length> radius-lg: 12px;

    // 排版：26 / 20 / 15 / 14 / 13 / 12 / 11
    in property <length> font-caption: 11px;
    in property <length> font-small: 12px;
    in property <length> font-secondary: 13px;
    in property <length> font-body: 14px;
    in property <length> font-subhead: 15px;
    in property <length> font-title: 20px;
    in property <length> font-display: 26px;
}
