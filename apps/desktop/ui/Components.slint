// 原生控件：遵循 DESIGN.md；不暴露默认桌面控件样式。
import { Theme } from "Theme.slint";

/// 分区小标题：11px / 600 / 低对比。
export component SectionLabel inherits Rectangle {
    in property <string> text;
    height: 26px;
    background: transparent;
    Text {
        text: root.text;
        color: Theme.ink-2;
        font-size: Theme.font-small;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
        width: 100%;
    }
}

/// 文本按钮：28px 高，1px 描边；主操作用紫色实底。
export component QuietButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> compact: false;
    callback clicked();

    height: compact ? 26px : 28px;
    border-radius: Theme.radius-sm;
    background: primary
        ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.hover : transparent);
    border-width: primary ? 0px : 1px;
    border-color: Theme.line-strong;

    HorizontalLayout {
        padding-left: primary ? 12px : 10px;
        padding-right: primary ? 12px : 10px;
        Text {
            text: root.label;
            color: primary ? white : Theme.ink-2;
            font-size: root.compact ? Theme.font-caption : Theme.font-small;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

/// 状态胶囊：24px 高，仅用于计数/状态，不承载长句。
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";

    height: 24px;
    width: label.preferred-width + 16px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: tone == "accent"
        ? Theme.accent-soft
        : (tone == "warn" ? Theme.warn-soft : Theme.neutral-soft);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        label := Text {
            text: root.text;
            color: tone == "accent"
                ? Theme.accent
                : (tone == "warn" ? Theme.warn-ink : Theme.ink-2);
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

/// 左侧导航行：36px 高；选中态为浅紫底 + 2px 指示条。
export component NavRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.accent-soft : (touch.has-hover ? Theme.hover : transparent);

    if (selected) : Rectangle {
        x: 0px;
        y: 9px;
        width: 2px;
        height: 18px;
        border-radius: 1px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                color: selected ? Theme.accent : Theme.ink;
                font-size: Theme.font-secondary;
                font-weight: selected ? 600 : 500;
                wrap: word-wrap;
                max-lines: 1;
                overflow: elide;
            }
            if (root.detail != "") : Text {
                text: root.detail;
                color: Theme.ink-3;
                font-size: Theme.font-caption;
                wrap: word-wrap;
                max-lines: 1;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
}

/// 培养板切换页签。
export component PlateTab inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: selected ? Theme.surface : (touch.has-hover ? Theme.hover : transparent);
    border-width: selected ? 1px : 0px;
    border-color: Theme.line;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.name;
            color: selected ? Theme.ink : Theme.ink-2;
            font-size: Theme.font-small;
            font-weight: selected ? 600 : 500;
            vertical-alignment: center;
        }
        Text {
            text: root.detail;
            color: Theme.ink-3;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: "选择培养板 " + root.name;
    accessible-action-default => { root.clicked(); }
}

/// 检查器行：section 是分区标题，field 是“标签 + 值”。
/// 继承 VerticalLayout，让多行值自然撑高，避免固定高度导致重叠。
export component InspectorRow inherits VerticalLayout {
    in property <string> kind;
    in property <string> label;
    in property <string> value;
    in property <bool> missing: false;

    spacing: 2px;

    if (kind == "section") : Text {
        text: root.label;
        height: 26px;
        color: Theme.ink-2;
        font-size: Theme.font-small;
        font-weight: 600;
        letter-spacing: 0.4px;
        vertical-alignment: bottom;
    }

    if (kind == "field") : Text {
        text: root.label;
        color: Theme.ink-3;
        font-size: Theme.font-caption;
    }

    if (kind == "field") : Text {
        text: root.value;
        color: root.missing ? Theme.ink-3 : Theme.ink;
        font-size: Theme.font-body;
        wrap: word-wrap;
    }
}
