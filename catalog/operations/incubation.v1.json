{
  "schema_version": 1,
  "identity": {
    "catalog": { "module_id": "op.incubation", "version": 1 },
    "title": "Controlled hold / incubation",
    "action_type": "incubation",
    "applicability": {
      "assay_families": ["cell_culture", "microbiology", "staining", "assay_development", "molecular"],
      "sample_kinds": ["culture", "stained_sample", "reaction_mixture"],
      "container_kinds": ["flask", "dish", "plate", "tube"],
      "variants": ["room_temperature_hold", "incubator_hold"],
      "exclusions": []
    }
  },
  "semantics": {
    "purpose": "Hold a prepared sample under defined conditions for a defined duration anchored to an explicit event; do not infer growth, attachment or reaction completion from elapsed time.",
    "preconditions": [
      "The sample/vessel is labelled and compatible with the intended hold conditions.",
      "The required temperature/atmosphere (if any) is defined by the method.",
      "The requested duration and time anchor are defined."
    ],
    "inputs": [
      {
        "port_id": "sample_in",
        "role": "source_sample",
        "object_type": "sample",
        "required": true,
        "cardinality": "one",
        "description": "Sample or culture to be held."
      },
      {
        "port_id": "vessel",
        "role": "destination_container",
        "object_type": "container",
        "required": true,
        "cardinality": "one",
        "description": "Compatible vessel."
      }
    ],
    "outputs": [
      {
        "port_id": "sample_out",
        "role": "destination_sample",
        "object_type": "sample",
        "required": true,
        "cardinality": "one",
        "description": "Sample after the hold; identity is preserved, state may change."
      }
    ],
    "sample_transitions": [
      {
        "transition_id": "sample_held",
        "input_port_id": "sample_in",
        "output_port_id": "sample_out",
        "effect": "state_changed",
        "note": "Hold changes the sample state or keeps it under defined conditions; it does not assert a measured biological outcome."
      }
    ]
  },
  "parameters": [
    {
      "key": "duration",
      "label": "Hold duration",
      "value_type": "number",
      "unit": "h",
      "required": true,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "positive" }],
      "description": "Protocol- or SOP-specific; no default duration is supplied.",
      "evidence": [
        {
          "evidence_id": "atcc.culture-guide",
          "kind": "peer_reviewed",
          "citation": "ATCC Animal Cell Culture Guide",
          "url": "https://www.atcc.org/resources/culture-guides/animal-cell-culture-guide",
          "locator": "Incubation optimum",
          "retrieved_at": "2026-11-05"
        }
      ]
    },
    {
      "key": "temperature",
      "label": "Hold temperature",
      "value_type": "number",
      "unit": "C",
      "required": false,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "positive" }],
      "description": "Optional only if the method specifies room temperature or another non-numeric condition; otherwise record it.",
      "evidence": [
        {
          "evidence_id": "atcc.culture-guide",
          "kind": "peer_reviewed",
          "citation": "ATCC Animal Cell Culture Guide",
          "url": "https://www.atcc.org/resources/culture-guides/animal-cell-culture-guide",
          "locator": "Incubation optimum",
          "retrieved_at": "2026-11-05"
        }
      ]
    },
    {
      "key": "co2",
      "label": "CO2 concentration (if required)",
      "value_type": "number",
      "unit": "%",
      "required": false,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "positive" }],
      "description": "Only for methods that require CO2; not a property of all incubation. The CO2-incubator capability is a method/instrument binding, not a generic requirement.",
      "evidence": [
        {
          "evidence_id": "thermo.subculturing",
          "kind": "peer_reviewed",
          "citation": "Thermo Fisher Subculturing Adherent Cells",
          "url": "https://www.thermofisher.com/us/en/home/references/gibco-cell-culture-basics/cell-culture-protocols/subculturing-adherent-cells.html",
          "locator": "Incubation and subculture timing",
          "retrieved_at": "2026-11-05"
        }
      ]
    },
    {
      "key": "time_anchor",
      "label": "Time anchor",
      "value_type": "text",
      "required": true,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "non_empty" }],
      "description": "Event relative to which the hold starts, e.g. seeding, treatment, staining or reaction start; not inferred from the Assay.",
      "evidence": [
        {
          "evidence_id": "thermo.subculturing",
          "kind": "peer_reviewed",
          "citation": "Thermo Fisher Subculturing Adherent Cells",
          "url": "https://www.thermofisher.com/us/en/home/references/gibco-cell-culture-basics/cell-culture-protocols/subculturing-adherent-cells.html",
          "locator": "Incubation and subculture timing",
          "retrieved_at": "2026-11-05"
        }
      ]
    }
  ],
  "execution": {
    "default_time_scope": "once",
    "allowed_time_scopes": ["once", "per_timepoint", "per_assay"],
    "instrument_requirements": [],
    "completion_checks": [
      {
        "check_id": "duration_and_anchor_recorded",
        "kind": "operational",
        "description": "Start/end times and the time anchor are recorded.",
        "blocking": true
      },
      {
        "check_id": "conditions_recorded",
        "kind": "operational",
        "description": "Actual temperature/atmosphere are recorded when the method specifies them.",
        "blocking": false
      }
    ],
    "record_fields": [
      { "key": "start_time", "label": "Start time", "value_type": "text", "required": true },
      { "key": "end_time", "label": "End time", "value_type": "text", "required": true },
      { "key": "actual_temperature", "label": "Actual temperature", "value_type": "number", "unit": "C", "required": false },
      { "key": "actual_co2", "label": "Actual CO2", "value_type": "number", "unit": "%", "required": false }
    ]
  },
  "knowledge": {
    "controls": [],
    "decision_points": [
      {
        "question": "Is the time anchor explicit?",
        "evidence": "Seeding/treatment/staining/reaction record.",
        "continue_if": "The anchor event and start time are recorded.",
        "stop_if": "The anchor is unknown; keep the duration unresolved."
      }
    ],
    "failure_modes": [
      {
        "mode": "Contamination",
        "symptom": "Turbidity, color change or unexpected growth.",
        "impact": "Sample invalid; downstream assay invalid.",
        "action": "Discard, decontaminate, and record the affected vessel."
      },
      {
        "mode": "Evaporation or dry-out",
        "symptom": "Reduced volume or edge effects.",
        "impact": "Changed concentration/osmolality.",
        "action": "Check vessel venting and humidity where required; record the deviation."
      },
      {
        "mode": "Temperature/atmosphere drift",
        "symptom": "Recorded condition differs from the method requirement.",
        "impact": "Invalid hold condition.",
        "action": "Record deviation and repeat if the method requires a controlled hold."
      }
    ],
    "readout": null,
    "evidence": [
      {
        "evidence_id": "thermo.subculturing",
        "kind": "peer_reviewed",
        "citation": "Thermo Fisher Subculturing Adherent Cells",
        "url": "https://www.thermofisher.com/us/en/home/references/gibco-cell-culture-basics/cell-culture-protocols/subculturing-adherent-cells.html",
        "locator": "Incubation and subculture timing",
        "retrieved_at": "2026-11-05"
      }
    ],
    "review_status": "research_draft"
  }
}
