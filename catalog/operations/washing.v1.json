{
  "schema_version": 1,
  "identity": {
    "catalog": { "module_id": "op.washing", "version": 1 },
    "title": "Liquid exchange / washing",
    "action_type": "washing",
    "applicability": {
      "assay_families": ["cell_culture", "elisa", "immunofluorescence", "biofilm", "3d_culture"],
      "sample_kinds": ["attached_cells", "plate_bound_sample", "biofilm", "spheroid"],
      "container_kinds": ["plate", "flask", "dish", "tube"],
      "variants": ["preserving", "lossy_possible"],
      "exclusions": []
    }
  },
  "semantics": {
    "purpose": "Exchange the liquid around a sample to remove unbound material. Sample identity may be preserved or may be lost depending on the method; this is not a universal no-loss operation.",
    "preconditions": [
      "The sample/vessel is compatible with the wash buffer and removal method.",
      "Wash buffer formulation, volume and cycles are defined by the protocol.",
      "Waste path is available; whether drying is allowed is method-specific."
    ],
    "inputs": [
      {
        "port_id": "sample_in",
        "role": "source_sample",
        "object_type": "sample",
        "required": true,
        "cardinality": "one",
        "description": "Sample in its vessel."
      },
      {
        "port_id": "vessel",
        "role": "destination_container",
        "object_type": "container",
        "required": true,
        "cardinality": "one",
        "description": "Vessel holding the sample."
      },
      {
        "port_id": "wash_buffer",
        "role": "reagent",
        "object_type": "reagent",
        "required": true,
        "cardinality": "one",
        "description": "Protocol-defined wash buffer."
      }
    ],
    "outputs": [
      {
        "port_id": "sample_out",
        "role": "destination_sample",
        "object_type": "sample",
        "required": true,
        "cardinality": "one",
        "description": "Sample after liquid exchange; identity may be preserved or partially lost."
      },
      {
        "port_id": "waste",
        "role": "destination_container",
        "object_type": "container",
        "required": false,
        "cardinality": "one",
        "description": "Waste liquid, not a tracked sample."
      }
    ],
    "sample_transitions": [
      {
        "transition_id": "sample_washed",
        "input_port_id": "sample_in",
        "output_port_id": "sample_out",
        "effect": "state_changed",
        "note": "Liquid environment changes. If loss_policy is lossy_possible, sample loss is possible and its magnitude is UNKNOWN unless measured."
      },
      {
        "transition_id": "buffer_to_waste",
        "input_port_id": "wash_buffer",
        "output_port_id": "waste",
        "effect": "consumed",
        "note": "Wash buffer leaves the vessel as waste; it is not a tracked sample."
      }
    ]
  },
  "parameters": [
    {
      "key": "wash_volume",
      "label": "Wash volume per vessel",
      "value_type": "number",
      "unit": "mL",
      "required": true,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "positive" }],
      "description": "Protocol-specific; no universal volume is supplied.",
      "evidence": [
        {
          "evidence_id": "thermo.adherent",
          "kind": "peer_reviewed",
          "citation": "Thermo Fisher Subculturing Adherent Cells",
          "url": "https://www.thermofisher.com/us/en/home/references/gibco-cell-culture-basics/cell-culture-protocols/subculturing-adherent-cells.html",
          "locator": "Wash step",
          "retrieved_at": "2026-11-05"
        }
      ]
    },
    {
      "key": "cycles",
      "label": "Wash cycles",
      "value_type": "integer",
      "required": true,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [{ "kind": "positive" }],
      "description": "Kit/protocol-specific; extra cycles may reduce sensitivity or detach sample.",
      "evidence": [
        {
          "evidence_id": "arbor.plate-wash",
          "kind": "vendor_manual",
          "citation": "Arbor Assays Plate Washing Instructions v.231213",
          "url": "https://www.arborassays.com/wp-content/uploads/2023/12/Plate-Washing-Instruction_231213.pdf",
          "locator": "Full two-page document",
          "retrieved_at": "2026-11-05"
        }
      ]
    },
    {
      "key": "loss_policy",
      "label": "Sample retention / possible loss",
      "value_type": "text",
      "required": true,
      "required_at": "run_freeze",
      "value_source": "design_variable",
      "constraints": [
        { "kind": "one_of", "values": ["preserving", "lossy_possible"] }
      ],
      "description": "Declare whether the method treats the sample as retained or allows unknown loss. Do not default to preserving.",
      "evidence": [
        {
          "evidence_id": "arbor.plate-wash",
          "kind": "vendor_manual",
          "citation": "Arbor Assays Plate Washing Instructions v.231213",
          "url": "https://www.arborassays.com/wp-content/uploads/2023/12/Plate-Washing-Instruction_231213.pdf",
          "locator": "Full two-page document",
          "retrieved_at": "2026-11-05"
        }
      ]
    }
  ],
  "execution": {
    "default_time_scope": "once",
    "allowed_time_scopes": ["once", "per_timepoint"],
    "instrument_requirements": [],
    "completion_checks": [
      {
        "check_id": "cycles_completed",
        "kind": "operational",
        "description": "The planned number of wash cycles was completed.",
        "blocking": true
      },
      {
        "check_id": "loss_policy_recorded",
        "kind": "operational",
        "description": "The method's retention/loss policy is recorded; if lossy, observed loss is recorded or marked UNKNOWN.",
        "blocking": true
      }
    ],
    "record_fields": [
      { "key": "wash_volume", "label": "Wash volume", "value_type": "number", "unit": "mL", "required": true },
      { "key": "cycles", "label": "Wash cycles", "value_type": "integer", "required": true },
      { "key": "loss_policy", "label": "Loss policy", "value_type": "text", "required": true },
      { "key": "observed_loss", "label": "Observed sample loss", "value_type": "text", "required": false },
      { "key": "residual_volume", "label": "Residual volume", "value_type": "number", "unit": "uL", "required": false }
    ]
  },
  "knowledge": {
    "controls": [],
    "decision_points": [
      {
        "question": "Does the method treat the sample as retained or allow loss?",
        "evidence": "Method template / acceptance criteria / visual check.",
        "continue_if": "The loss policy is explicit.",
        "stop_if": "The policy is unknown; keep the wash unresolved or use Custom Step."
      }
    ],
    "failure_modes": [
      {
        "mode": "Sample loss",
        "symptom": "Cells or bound material detached into waste.",
        "impact": "Sample identity or quantity is not preserved.",
        "action": "Record sample loss; repeat with gentler washing if the protocol allows."
      },
      {
        "mode": "Insufficient washing",
        "symptom": "High background or residual unbound material.",
        "impact": "Reduced sensitivity/increased variability.",
        "action": "Follow the kit/protocol cycle count; do not arbitrarily add cycles."
      },
      {
        "mode": "Drying (method-specific)",
        "symptom": "Wells dry before the next step.",
        "impact": "May be irreversible for some assays; other methods intentionally dry.",
        "action": "Follow the method's drying instruction; record if unintended."
      }
    ],
    "readout": null,
    "evidence": [
      {
        "evidence_id": "thermo.adherent",
        "kind": "peer_reviewed",
        "citation": "Thermo Fisher Subculturing Adherent Cells",
        "url": "https://www.thermofisher.com/us/en/home/references/gibco-cell-culture-basics/cell-culture-protocols/subculturing-adherent-cells.html",
        "locator": "Wash step",
        "retrieved_at": "2026-11-05"
      },
      {
        "evidence_id": "arbor.plate-wash",
        "kind": "vendor_manual",
        "citation": "Arbor Assays Plate Washing Instructions v.231213",
        "url": "https://www.arborassays.com/wp-content/uploads/2023/12/Plate-Washing-Instruction_231213.pdf",
        "locator": "Full two-page document",
        "retrieved_at": "2026-11-05"
      }
    ],
    "review_status": "research_draft"
  }
}
